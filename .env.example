# =============================================================================
# Radar Brasil (mcp-brasil) — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores necessários:
#   cp .env.example .env

# --- Transparência (obrigatória para a feature transparencia) ---
# Cadastre-se gratuitamente em:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# --- Dados Gov BR (obrigatória para a feature dados_gov_br) ---
# Acesse dados.gov.br com conta Gov.br e gere o token em "Minha Conta".
DADOS_GOV_BR_API_KEY=

# --- DataJud (obrigatória para a feature datajud) ---
# Cadastre-se gratuitamente em:
# https://datajud.cnj.jus.br
DATAJUD_API_KEY=

# --- Anúncios Eleitorais (obrigatória para a feature anuncios_eleitorais) ---
# Obtenha um token em:
# https://developers.facebook.com/docs/marketing-api/reference/ad-library/
META_ACCESS_TOKEN=

# --- Autenticação HTTP (opcional) ---
# Quando definido, o server requer Authorization: Bearer <token> nas chamadas HTTP.
# Deixe vazio para uso local/stdio sem autenticação.
MCP_BRASIL_API_TOKEN=

# --- Authentication Strategy ---
# Modo de autenticação do server MCP. Valores aceitos: none | static | oauth | multi | radar
# Auto-detect: se não for setado, usa "static" quando MCP_BRASIL_API_TOKEN está
# definido, senão "none". Mantém backward compat com instalações existentes.
#
# Exemplos:
#   MCP_BRASIL_AUTH_MODE=none     # público (útil para IP allowlist/stdio)
#   MCP_BRASIL_AUTH_MODE=static   # Bearer token estático (requer MCP_BRASIL_API_TOKEN)
#   MCP_BRASIL_AUTH_MODE=oauth    # OAuth 2.0 com DCR (Claude.ai web)
#   MCP_BRASIL_AUTH_MODE=multi    # OAuth + static simultâneos (Claude.ai + Foundry)
#   MCP_BRASIL_AUTH_MODE=radar    # Radar Brasil: usuários, chaves por cliente, planos e Mercado Pago
# MCP_BRASIL_AUTH_MODE=

# --- OAuth (apenas quando MCP_BRASIL_AUTH_MODE=oauth) ---
# Provider OAuth. Valores aceitos: azure | google | github | workos
# MCP_BRASIL_OAUTH_PROVIDER=azure

# URL pública do server MCP (ex: https://mcp-brasil.example.com).
# Obrigatório quando AUTH_MODE=oauth. Usado para construir redirect URIs.
# MCP_BRASIL_BASE_URL=

# --- OAuth: Azure (Entra ID) ---
# Criar um App Registration no Portal Azure → Entra ID → App Registrations.
# Redirect URI no App Registration deve ser {MCP_BRASIL_BASE_URL}/auth/callback.
# Ver docs/deploy/azure-oauth.md para o passo a passo completo.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_REQUIRED_SCOPES=read

# --- OAuth: Google ---
# Criar credentials em https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REQUIRED_SCOPES=openid,email

# --- OAuth: GitHub ---
# Criar OAuth App em https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REQUIRED_SCOPES=

# --- OAuth: WorkOS (AuthKit) ---
# Criar AuthKit app em https://workos.com
# AUTHKIT_DOMAIN=
# AUTHKIT_REQUIRED_SCOPES=

# --- Radar Brasil (apenas quando MCP_BRASIL_AUTH_MODE=radar) ---
# Guia completo: docs/deploy/radar-brasil.md
# URL pública do servidor (usada nos links de retorno e no webhook do Mercado Pago).
# MCP_BRASIL_BASE_URL=https://radar.seudominio.com.br
#
# Banco SQLite com usuários, chaves, assinaturas e pagamentos. Use um volume persistente.
# RADAR_DB_PATH=data/radar.db
#
# Assina as sessões do portal. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# RADAR_SECRET_KEY=
#
# Planos (opcional). Sem isso valem: essencial R$49,90 | profissional R$149,90 | empresarial R$499,90
# RADAR_PLANOS=[{"id":"essencial","nome":"Essencial","preco":49.9,"consultas_dia":300}]
#
# Dias de tolerância após o vencimento, teste grátis no cadastro e duração da sessão do portal
# RADAR_CARENCIA_DIAS=3
# RADAR_TESTE_DIAS=0
# RADAR_PLANO_TESTE=essencial
# RADAR_SESSAO_HORAS=72

# --- ARGOS: sala de situação e coletor (docs/deploy/argos-sala-de-situacao.md) ---
# RADAR_NOME=ARGOS
# RADAR_INDICADORES_DB=data/indicadores.db
# RADAR_CIDADES=Dourados/MS,Campo Grande/MS
# RADAR_ALIMENTOS_LOCALIDADES=brasil,campo_grande
# RADAR_AREA_INMET=Mato Grosso do Sul
# RADAR_COLETA_MINUTOS=15
# RADAR_COLETOR_EMBUTIDO=1

# --- Alertas: Telegram (gratuito) ---
# 1) Fale com @BotFather no Telegram → /newbot → copie o token
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=ArgosAlertasBot

# --- Alertas: WhatsApp Cloud API (Meta, oficial) ---
# Guia: docs/deploy/alertas-whatsapp-telegram.md
# WHATSAPP_TOKEN=EAAG...                 # token permanente de usuário do sistema
# WHATSAPP_PHONE_NUMBER_ID=1234567890    # ID do número (não é o telefone)
# WHATSAPP_TEMPLATE=alerta_argos         # template aprovado com {{1}} título e {{2}} detalhes
# WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# RADAR_ALERTAS_MAX_ITENS=8

# --- Mercado Pago (apenas quando MCP_BRASIL_AUTH_MODE=radar) ---
# Credenciais em https://www.mercadopago.com.br/developers/panel/app → sua aplicação.
# Use o Access Token de TESTE até validar o fluxo; depois troque pelo de produção.
# MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta exibida em Webhooks → Configurar notificações (valida o x-signature).
# MERCADOPAGO_WEBHOOK_SECRET=

# --- Tool Discovery (opcional — valores padrão já funcionam) ---
# Modos: "bm25" (padrão), "code_mode" (experimental), "none" (sem filtro)
# MCP_BRASIL_TOOL_SEARCH=bm25

# --- LLM Discovery — recomendar_tools / planejar_consulta (opcional) ---
# Necessário para as tools recomendar_tools e planejar_consulta (requer: pip install mcp-brasil[llm])
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- HTTP Client (opcional — valores padrão já funcionam) ---
# MCP_BRASIL_HTTP_TIMEOUT=30.0
# MCP_BRASIL_HTTP_MAX_RETRIES=3
# MCP_BRASIL_HTTP_BACKOFF_BASE=1.0
# MCP_BRASIL_USER_AGENT=mcp-brasil/0.7.2

# --- Azure AI Foundry Agent Service (opcional — ver docs/deploy/foundry-teams.md) ---
# Endpoint do projeto AI Foundry (formato: https://<resource>.services.ai.azure.com/api/projects/<project>)
# PROJECT_ENDPOINT=https://agent-brasil-resource.services.ai.azure.com/api/projects/agent-brasil
# MODEL_DEPLOYMENT=gpt-4o
# MCP_CONNECTION_ID=mcp-brasil
